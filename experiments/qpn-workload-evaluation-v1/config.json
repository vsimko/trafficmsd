{
  "schema_version": "1.0",
  "experiment_family": "westermo-qpn-workload-evaluation-v1",
  "time_unit": "s",
  "bin_width": 1.0,
  "workload_mapping": {
    "quantity_unit": "bytes",
    "bytes_per_job": 1000000,
    "remainder_policy": "carry_forward",
    "arrival_placement": "bin_start"
  },
  "qpn_model": {
    "model_id": "trafficmsd-westermo-qpn-mm1-v1",
    "service_distribution": "exponential",
    "service_rate_per_s": 1.0,
    "queue_discipline": "FCFS",
    "servers": 1
  },
  "simulation": {
    "warmup_policy": "none",
    "termination_kind": "simulated_time",
    "replication_seeds": [23000, 23001, 23002, 23003, 23004, 23005, 23006, 23007, 23008, 23009],
    "confidence_level": 0.95
  },
  "metrics": {
    "primary": ["throughput", "queue_length"],
    "secondary": ["utilization", "residence_time"]
  },
  "limitations": [
    "One abstract QPN job represents 1000000 captured-frame bytes; it is not a packet, flow, request, or application transaction.",
    "The model is a single FCFS queue with exponential service and is an illustrative workload-level system model.",
    "The deterministic reconstruction condition is not a stochastic traffic generator."
  ]
}
