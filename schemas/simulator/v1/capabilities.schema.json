{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trafficmsd.dev/schemas/simulator/v1/capabilities.schema.json",
  "title": "TrafficMSD backend capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "supported_constructs",
    "supported_metrics",
    "supported_warmup_policies",
    "supported_termination_kinds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supported_constructs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_warmup_policies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "fixed_time",
          "mser5"
        ]
      }
    },
    "supported_termination_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "simulated_time",
          "completions"
        ]
      }
    }
  }
}
