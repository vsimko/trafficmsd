{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trafficmsd.dev/schemas/simulator/v1/result.schema.json",
  "title": "TrafficMSD normalized simulation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "backend",
    "checksums",
    "validation",
    "replications",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "schedule_sha256",
        "experiment_sha256"
      ],
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schedule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "experiment_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "replications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "seed",
          "termination_reason",
          "raw_observations"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "termination_reason": {
            "enum": [
              "completed",
              "time_limit",
              "cancelled",
              "backend_error"
            ]
          },
          "raw_observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "metric",
                "value",
                "unit"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "available",
              "unsupported",
              "not_recorded"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimate": {
            "type": [
              "number",
              "null"
            ]
          },
          "standard_deviation": {
            "type": [
              "number",
              "null"
            ]
          },
          "confidence_interval": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "runtime": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
