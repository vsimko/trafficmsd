{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trafficmsd.dev/schemas/simulator/v1/experiment.schema.json",
  "title": "TrafficMSD simulator-neutral experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "model",
    "schedule",
    "time_unit",
    "warmup",
    "termination",
    "replications",
    "required_metrics",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "sha256"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule_id",
        "sha256"
      ],
      "properties": {
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "time_unit": {
      "enum": [
        "s",
        "ms",
        "us",
        "ns"
      ]
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "none",
            "fixed_time",
            "mser5"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "simulated_time",
            "completions"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "replications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "seeds"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "offered_jobs",
          "completed_jobs",
          "throughput",
          "queue_length",
          "utilization",
          "residence_time",
          "response_time"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructs",
        "metrics"
      ],
      "properties": {
        "constructs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
